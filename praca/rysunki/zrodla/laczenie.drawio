<mxfile><diagram id="laczenie" name="laczenie"><mxGraphModel grid="0" page="0" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="cic" value="&lt;b&gt;CIC-IDS2017&lt;/b&gt;&lt;br&gt;poniedziałek, wtorek, środa, piątek" style="rounded=1;arcSize=12;fillColor=#FFFFFF;fontSize=13;spacing=3;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fontFamily=Times New Roman;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="250.0" height="44" as="geometry"/></mxCell><mxCell id="gen" value="&lt;b&gt;GeNIS&lt;/b&gt;&lt;br&gt;wszystkie nagrania" style="rounded=1;arcSize=12;fillColor=#FFFFFF;fontSize=13;spacing=3;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fontFamily=Times New Roman;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="270.0" y="0" width="250.0" height="44" as="geometry"/></mxCell><mxCell id="lc" value="etykiety wspólną regułą okna&lt;br&gt;&lt;i&gt;label_cic.py&lt;/i&gt;" style="rounded=0;fillColor=#FFFFFF;fontSize=13;spacing=3;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fontFamily=Times New Roman;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="0" y="70" width="250.0" height="40" as="geometry"/></mxCell><mxCell id="lg" value="etykiety wspólną regułą okna&lt;br&gt;&lt;i&gt;label_genis.py&lt;/i&gt;" style="rounded=0;fillColor=#FFFFFF;fontSize=13;spacing=3;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fontFamily=Times New Roman;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="270.0" y="70" width="250.0" height="40" as="geometry"/></mxCell><mxCell id="ctx" value="&lt;b&gt;Cechy kontekstu hosta i historia okien FT&lt;/b&gt; liczone na pełnych danych,&lt;br&gt;osobno w każdym nagraniu (przed usunięciem klas i próbkowaniem)" style="rounded=0;fillColor=#E6E6E6;fontSize=13;spacing=3;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fontFamily=Times New Roman;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="0" y="136" width="520" height="40" as="