<mxfile><diagram id="potok" name="potok"><mxGraphModel grid="0" page="0" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="mn" value="&lt;b&gt;Sesje M0–M6 w Mininecie&lt;/b&gt;&lt;br&gt;ruch normalny + ataki A1–A4 i Z1&lt;br&gt;&lt;i&gt;features/run_session.py&lt;/i&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;fontSize=13;spacing=4;fontFamily=Times New Roman;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="290.0" height="56" as="geometry"/></mxCell><mxCell id="pub" value="&lt;b&gt;Zbiory publiczne&lt;/b&gt;&lt;br&gt;CIC-IDS2017, GeNIS" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;fontSize=13;spacing=4;fontFamily=Times New Roman;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="310.0" y="0" width="290.0" height="56" as="geometry"/></mxCell><mxCell id="rec" value="&lt;b&gt;Nagranie na routerze r0&lt;/b&gt;&lt;br&gt;PCAP + okna ataków (ground truth)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6E6E6;strokeColor=#000000;strokeWidth=1;fontSize=13;spacing=4;fontFamily=Times New Roman;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="0" y="86" width="290.0" height="46" as="geometry"/></mxCell><mxCell id="pcap" value="&lt;b&gt;Nagrania PCAP&lt;/b&gt;&lt;br&gt;+ okna ataków (oficjalne, CNS2022)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6E6E6;strokeColor=#000000;strokeWidth=1;fontSize=13;spacing=4;fontFamily=Times New Roman;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="310.0" y="86" width="290.0" height="46" as="geometry"/></mxCell><mxCell id="ext" value="&lt;b&gt;Ekstrakcja przepływów&lt;/b&gt; (jedna konfiguracja dla wszystkich danych)&lt;br&gt;editcap (duplikaty), reordercap, NFStream: idle 60 s, active 120 s, zamykanie TCP&lt;br&gt;&lt;i&gt;features/extract_flows.py&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6E6E6;strokeColor=#000000;strokeWidth=1;fontSize=13;spacing=4;fontFamily=Times New Roman;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="0" y="162" width="600" height="60" as="geometry"/></mxCell><mxCell id="lab" value="&lt;b&gt;Etykiety&lt;/b&gt;: jedna reguła okna ataku dla Mininetu, CIC i GeNIS; kontrola wobec logów narzędzi&lt;br&gt;&lt;i&gt;features/label_flows.py, label_cic.py, label_genis.py, check_labels.py&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6E6E6;strokeColor=#000000;strokeWidth=1;fontSize=13;spacing=4;fontFamily=Times New Roman;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="0" y="252" width="600" height="46" as="geometry"/></mxCell><mxCell id="feat" value="&lt;b&gt;Cechy&lt;/b&gt;: 57 cech liczbowych + one-hot (protokół, port); kontekst hosta z 60 s; okno 8 przepływów dla FT&lt;br&gt;&lt;i&gt;models/flow_features.py, features/window_features.py&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6E6E6;strokeColor=#000000;strokeWidth=1;fontSize=13;spacing=4;fontFamily=Times New Roman;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="0" y="328" width="600" height="46" as="geometry"/></mxCell><mxCell id="mfr" value="modele" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;strokeWidth=1;dashed=1;dashPattern=4 3;verticalAlign=top;align=left;spacingLeft=6;fontSize=12;fontFamily=Times New Roman;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="0" y="404" width="600" height="66" as="geometry"/></mxCell><mxCell id="m_b" value="baseline&lt;br&gt;progowy" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#B3B3B3;strokeColor=#000000;strokeWidth=1;fontSize=13;fontFamily=Times New Roman;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="10.0" y="424" width="136.0" height="38" as="geometry"/></mxCell><mxCell id="m_if" value="Isolation&lt;br&gt;Forest" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#B3B3B3;strokeColor=#000000;strokeWidth=1;fontSize=13;fontFamily=Times New Roman;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="158.0" y="424" width="136.0" height="38" as="geometry"/></mxCell><mxCell id="m_rf" value="Random&lt;br&gt;Forest" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#B3B3B3;strokeColor=#000000;strokeWidth=1;fontSize=13;fontFamily=Times New Roman;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="306.0" y="424" width="136.0" height="38" as="geometry"/></mxCell><mxCell id="m_ft" value="Flow-&lt;br&gt;Transformer" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#B3B3B3;strokeColor=#000000;strokeWidth=1;fontSize=13;fontFamily=Times New Roman;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="454.0" y="424" width="136.0" height="38" as="geometry"/></mxCell><mxCell id="sc" value="&lt;b&gt;Scenariusze S0, S1, S2&lt;/b&gt;: trening, próg z walidacji (ok. 1% FPR), test na sesjach M1–M6&lt;br&gt;&lt;i&gt;models/run_experiments.py, models/run_s2.py&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6E6E6;strokeColor=#000000;strokeWidth=1;fontSize=13;spacing=4;fontFamily=Times New Roman;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="0" y="500" width="600" height="46" as="geometry"/></mxCell><mxCell id="st" value="&lt;b&gt;Statystyka&lt;/b&gt;&lt;br&gt;średnia ± 95% CI po sesjach&lt;br&gt;&lt;i&gt;stats/summarize.py&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6E6E6;strokeColor=#000000;strokeWidth=1;fontSize=13;spacing=4;fontFamily=Times New Roman;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="0" y="576" width="290.0" height="56" as="geometry"/></mxCell><mxCell id="app" value="&lt;b&gt;Aplikacja monitorująca&lt;/b&gt; (Dash)&lt;br&gt;odtwarzanie sesji, alerty w SQLite&lt;br&gt;&lt;i&gt;app/dashboard.py&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6E6E6;strokeColor=#000000;strokeWidth=1;fontSize=13;spacing=4;fontFamily=Times New Roman;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="310.0" y="576" width="290.0" height="56" as="geometry"/></mxCell><mxCel